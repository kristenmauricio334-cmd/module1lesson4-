import streamlit as st
import pandas as pd

st.title("Pushbutton Controls an LED")

button = st.checkbox("BUTTON PRESSED")

if button:
    st.success("BUTTON ACTIVATED")
    st.write("LED Status: ON")
    st.metric("Arduino Pin", "D8")
else:
    st.info("SYSTEM STANDBY")
    st.write("LED Status: OFF")
    st.metric("Arduino Pin", "D8")

data = pd.DataFrame({
    "Button State": ["Pressed", "Released"],
    "LED Status": ["ON", "OFF"]
})

st.subheader("Button State Comparison")
st.dataframe(data, use_container_width=True)
